{
  "name": "dr-bike-sydney",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@growthbook/growthbook": "^1.6.5",
    "@sentry/node": "^10.62.0",
    "@supabase/supabase-js": "^2.110.7",
    "pdfkit": "^0.19.1",
    "resend": "^6.18.0",
    "sharp": "^0.35.3",
    "stripe": "^22.3.0",
    "twilio": "^6.0.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "eslint": "^10.8.0",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.0",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint api/ js/ middleware.js",
    "lint:fix": "eslint api/ js/ middleware.js --fix",
    "format": "prettier --write api/ js/ css/",
    "format:check": "prettier --check api/ js/ css/",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/check.mjs && node scripts/i18n-check.mjs && node scripts/plan-prices-check.mjs",
    "predeploy": "npm run check && vitest run --passWithNoTests",
    "deploy": "npx vercel --prod --yes",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "audit:security": "npm audit --audit-level=high",
    "i18n:check": "node scripts/i18n-check.mjs",
    "prices:check": "node scripts/plan-prices-check.mjs",
    "services:check": "node scripts/services-sync-check.mjs"
  },
  "lint-staged": {
    "api/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "js/**/*.js": [
      "prettier --write"
    ],
    "css/**/*.css": [
      "prettier --write"
    ]
  }
}
