{
  "name": "dr-bike-sydney",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@growthbook/growthbook": "^1.7.0",
    "@sentry/node": "^10.71.0",
    "@supabase/supabase-js": "^2.112.3",
    "pdfkit": "^0.19.1",
    "resend": "^6.22.0",
    "sharp": "^0.35.3",
    "stripe": "^22.5.0",
    "twilio": "^6.1.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "^10.9.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint api/ js/ middleware.js",
    "lint:fix": "eslint api/ js/ middleware.js --fix",
    "format": "prettier --write api/ js/ css/",
    "format:check": "prettier --check api/ js/ css/",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/check.mjs && node scripts/i18n-check.mjs && node scripts/plan-prices-check.mjs && node scripts/icons-check.mjs && node scripts/color-check.mjs && node scripts/dark-theme-check.mjs && node scripts/versioned-assets-check.mjs",
    "predeploy": "npm run check && vitest run --passWithNoTests",
    "deploy": "npx vercel --prod --yes",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "audit:security": "npm audit --audit-level=high",
    "i18n:check": "node scripts/i18n-check.mjs",
    "prices:check": "node scripts/plan-prices-check.mjs",
    "icons:check": "node scripts/icons-check.mjs",
    "color:check": "node scripts/color-check.mjs",
    "services:check": "node scripts/services-sync-check.mjs",
    "suburbs:generate": "node scripts/generate-suburb-pages.mjs",
    "blog:translate": "node scripts/translate-blog-posts.mjs",
    "static-pages:translate": "node scripts/translate-static-pages.mjs"
  },
  "lint-staged": {
    "api/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "js/**/*.js": [
      "prettier --write"
    ],
    "css/**/*.css": [
      "prettier --write"
    ]
  }
}
