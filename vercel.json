{
  "rewrites": [
    { "source": "/admin.html", "destination": "/admin.html" },
    { "source": "/mechanic.html", "destination": "/mechanic.html" },
    { "source": "/landing.html", "destination": "/landing.html" },
    { "source": "/track.html", "destination": "/track.html" },
    { "source": "/notifications.html", "destination": "/notifications.html" },
    { "source": "/payments.html", "destination": "/payments.html" },
    { "source": "/((?!api/|admin\\.html|mechanic\\.html|landing\\.html|track\\.html|notifications\\.html|payments\\.html|.*\\.png|.*\\.svg|.*\\.json|.*\\.js|.*\\.txt|.*\\.xml).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache" }
      ]
    }
  ]
}
