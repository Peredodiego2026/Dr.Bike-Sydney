{
  "crons": [
    {
      "path": "/api/send-reminders?type=2h",
      "schedule": "0 9 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/send-b2b-inquiry",
      "destination": "/api/send-cron?type=b2b"
    },
    {
      "source": "/api/send-upsell",
      "destination": "/api/send-cron?type=upsell"
    },
    {
      "source": "/api/send-birthday",
      "destination": "/api/send-cron?type=birthday"
    },
    {
      "source": "/api/send-reengagement",
      "destination": "/api/send-cron?type=reengagement"
    },
    {
      "source": "/api/send-abandoned",
      "destination": "/api/send-cron?type=abandoned"
    },
    {
      "source": "/api/send-service-reminders",
      "destination": "/api/send-cron?type=service"
    },
    {
      "source": "/api/cancel-subscription",
      "destination": "/api/create-payment-session?type=cancel-subscription"
    },
    {
      "source": "/api/diagnose-bike",
      "destination": "/api/chat?type=diagnose"
    },
    {
      "source": "/api/health",
      "destination": "/api/chat?type=health"
    },
    {
      "source": "/api/create-payment-intent",
      "destination": "/api/create-payment-session?type=intent"
    },
    {
      "source": "/api/send-sms",
      "destination": "/api/send-message?channel=sms"
    },
    {
      "source": "/api/send-whatsapp",
      "destination": "/api/send-message?channel=whatsapp"
    },
    {
      "source": "/api/admin-auth",
      "destination": "/api/auth?role=admin"
    },
    {
      "source": "/api/mechanic-auth",
      "destination": "/api/auth?role=mechanic"
    },
    {
      "source": "/((?!api/|\\.well-known/|.*\\.html|.*\\.png|.*\\.svg|.*\\.json|.*\\.js|.*\\.txt|.*\\.xml|.*\\.webmanifest|.*\\.ico|.*\\.css|.*\\.woff|.*\\.woff2).*)",
      "destination": "/landing.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=*"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://www.googletagmanager.com https://connect.facebook.net https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://tgpipbloisahufaywhqb.supabase.co https://api.stripe.com https://www.google-analytics.com https://region1.analytics.google.com https://nominatim.openstreetmap.org https://unpkg.com https://cdn.jsdelivr.net wss://tgpipbloisahufaywhqb.supabase.co; frame-src https://js.stripe.com https://hooks.stripe.com; base-uri 'self'; form-action 'self' https://checkout.stripe.com;"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache"
        }
      ]
    },
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}