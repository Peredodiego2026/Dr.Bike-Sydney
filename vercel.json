{
  "crons": [
    { "path": "/api/send-reminders?type=2h", "schedule": "0 22 * * *" },
    { "path": "/api/send-cron?type=all",     "schedule": "0 9 * * *"  }
  ],
  "rewrites": [
    {
      "source": "/api/send-b2b-inquiry",
      "destination": "/api/send-cron?type=b2b"
    },
    {
      "source": "/api/send-upsell",
      "destination": "/api/send-cron?type=upsell"
    },
    {
      "source": "/api/send-birthday",
      "destination": "/api/send-cron?type=birthday"
    },
    {
      "source": "/api/send-reengagement",
      "destination": "/api/send-cron?type=reengagement"
    },
    {
      "source": "/api/send-abandoned",
      "destination": "/api/send-cron?type=abandoned"
    },
    {
      "source": "/api/send-service-reminders",
      "destination": "/api/send-cron?type=service"
    },
    {
      "source": "/api/cancel-subscription",
      "destination": "/api/create-payment-session?type=cancel-subscription"
    },
    {
      "source": "/api/pause-subscription",
      "destination": "/api/create-payment-session?type=pause-subscription"
    },
    {
      "source": "/api/resume-subscription",
      "destination": "/api/create-payment-session?type=resume-subscription"
    },
    {
      "source": "/api/buy-gift-card",
      "destination": "/api/create-payment-session?type=gift-card"
    },
    {
      "source": "/api/diagnose-bike",
      "destination": "/api/chat?type=diagnose"
    },
    {
      "source": "/api/health",
      "destination": "/api/chat?type=health"
    },
    {
      "source": "/api/create-payment-intent",
      "destination": "/api/create-payment-session?type=intent"
    },
    {
      "source": "/api/send-sms",
      "destination": "/api/send-message?channel=sms"
    },
    {
      "source": "/api/send-whatsapp",
      "destination": "/api/send-message?channel=whatsapp"
    },
    {
      "source": "/api/eta",
      "destination": "/api/send-message?channel=eta"
    },
    {
      "source": "/api/admin-auth",
      "destination": "/api/auth?role=admin"
    },
    {
      "source": "/api/analytics",
      "destination": "/api/auth?role=admin-analytics"
    },
    {
      "source": "/api/mechanic-auth",
      "destination": "/api/auth?role=mechanic"
    },
    {
      "source": "/api/google-calendar-connect",
      "destination": "/api/auth?role=google-calendar-connect"
    },
    {
      "source": "/api/google-calendar-callback",
      "destination": "/api/auth?role=google-calendar-callback"
    },
    {
      "source": "/track",
      "destination": "/track.html"
    },
    {
      "source": "/(bike-check|bondi|business|cbd|chatswood|cycling-map|eastern-suburbs|hills-district|hornsby|inner-west|manly|marrickville|mosman|newtown|north-shore|northern-beaches|parramatta|penrith|privacy|ryde|st-george|strathfield|surry-hills|sutherland-shire|terms)",
      "destination": "/$1.html"
    },
    {
      "source": "/(es|zh)/(bondi|cbd|chatswood|eastern-suburbs|hills-district|hornsby|inner-west|manly|marrickville|mosman|newtown|north-shore|northern-beaches|parramatta|penrith|ryde|st-george|strathfield|surry-hills|sutherland-shire)",
      "destination": "/$1/$2.html"
    },
    {
      "source": "/blog/(best-bikes-for-sydney-commuting-2026|cycling-safety-tips-sydney-roads|electric-bike-laws-nsw-2026|how-to-choose-a-bike-mechanic-sydney|how-to-clean-your-bike-chain-sydney)",
      "destination": "/blog/$1.html"
    },
    {
      "source": "/((?!api/|\\.well-known/|.*\\.html|.*\\.png|.*\\.svg|.*\\.json|.*\\.js|.*\\.txt|.*\\.xml|.*\\.webmanifest|.*\\.ico|.*\\.css|.*\\.woff|.*\\.woff2).*)",
      "destination": "/landing.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=*"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://cdn.jsdelivr.net https://unpkg.com https://eu.i.posthog.com https://*.i.posthog.com https://www.googletagmanager.com https://js-de.sentry-cdn.com https://browser.sentry-cdn.com https://api.mapbox.com https://www.gstatic.com https://connect.facebook.net https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.mapbox.com https://cdn.jsdelivr.net https://unpkg.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co https://*.mapbox.com https://*.tile.openstreetmap.org https://www.googletagmanager.com https://eu.i.posthog.com https://*.i.posthog.com; connect-src 'self' https://*.supabase.co https://api.stripe.com https://eu.i.posthog.com https://*.i.posthog.com https://*.sentry.io https://*.ingest.de.sentry.io https://browser.sentry-cdn.com https://cdn.jsdelivr.net https://api.mapbox.com https://nominatim.openstreetmap.org https://router.project-osrm.org wss://*.supabase.co https://www.google-analytics.com https://cdn.growthbook.io; frame-src https://js.stripe.com https://hooks.stripe.com https://challenges.cloudflare.com; worker-src blob: 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache"
        }
      ]
    },
    {
      "source": "/((?!api/|\\.well-known/|.*\\.png|.*\\.svg|.*\\.json|.*\\.js|.*\\.txt|.*\\.xml|.*\\.webmanifest|.*\\.ico|.*\\.css|.*\\.woff|.*\\.woff2|.*\\.jpg|.*\\.jpeg|.*\\.webp|.*\\.gif).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|gif|svg|ico|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(icon-[a-z0-9-]+|apple-touch-icon|favicon-[0-9]+|og-image)\\.(png|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
