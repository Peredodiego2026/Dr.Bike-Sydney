# Push notifications (VAPID — generate with: npx web-push generate-vapid-keys)
VAPID_EMAIL=mailto:admin@drbikesydney.com.au
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Internal API secret — shared secret so send-cron.js / send-reminders.js /
# auth.js can call send-email.js, send-message.js, send-push.js without a
# browser Origin header. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=

# ── NEW PACKAGES (add these to Vercel: vercel env add) ───────────────────────

# Sentry — error tracking for API routes
# Setup: sentry.io -> New Project -> Node.js -> copy DSN
SENTRY_DSN=https://XXXX@XXXX.ingest.sentry.io/XXXX

# PostHog — product analytics, funnels, session replay (open source)
# Setup: posthog.com -> New Project -> copy Project API Key
# Also update POSTHOG_KEY in js/analytics.js with the phc_xxx key
POSTHOG_KEY=phc_XXXXXXXXXXXXXXXXXXXX

# Mapbox — real-time tracking map (free tier: 50k loads/month)
# Setup: mapbox.com -> Account -> Tokens -> copy default public token
# Use for: track.html live mechanic map, route optimization in admin
MAPBOX_TOKEN=pk.eyJ1IjoiZHJiaWtlc3lkbmV5IiwiYSI6Ii4uLiJ9.XXXX

# GrowthBook — feature flags & A/B testing (optional, can self-host)
# Setup: growthbook.io -> SDK Connections -> copy Client Key
GROWTHBOOK_CLIENT_KEY=sdk-XXXXXXXXXXXX

# Google Maps (frontend key hardcoded in index.html — must be restricted in Google Cloud Console)
# Action required: APIs & Services -> Credentials -> HTTP referrers -> add drbikesydney.com.au/*
